{
  "name": "pi-agent-delegation",
  "version": "0.1.0",
  "private": true,
  "description": "Named headless Pi, Claude Code, Codex, Cursor, and OpenCode subagents with reusable compute profiles",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tridha643/pi-packages.git",
    "directory": "packages/pi-agent-delegation"
  },
  "homepage": "https://github.com/tridha643/pi-packages/tree/main/packages/pi-agent-delegation",
  "keywords": [
    "pi-package"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "exports": "./index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts vendor/headless/manager.test.ts vendor/headless/result-delivery.test.ts vendor/headless/context-usage.test.ts vendor/headless/preflight.test.ts vendor/headless/takeover.test.ts vendor/headless/cursor-protocol.test.ts vendor/headless/openai-fast.test.ts vendor/headless/opencode-protocol.test.ts",
    "test:e2e": "node --test --experimental-strip-types test/e2e/pi-extension.e2e.test.ts",
    "test:live": "node --test --experimental-strip-types vendor/headless/claude.test.ts vendor/headless/codex.test.ts vendor/headless/cursor.test.ts vendor/headless/opencode.test.ts",
    "verify": "npm run check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.207",
    "@cursor/sdk": "^1.0.24",
    "@opencode-ai/sdk": "^1.18.5",
    "effect": "4.0.0-beta.98",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "^24.0.0",
    "typebox": "1.3.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.13"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
